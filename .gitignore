# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.cache

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Environment variables and secrets
.env
.env.local
.env.*.local

# Log files
*.log

# Build and test artifacts
htmlcov/
docs/_build/

# Compiled native binaries
*.exe
*.dll
*.so
*.dylib

# Database files
*.db

# Local datasets and annotations
datasets/
data/
*.ndjson

# Model checkpoints and weights
checkpoints/
checkpoints_data/
*.pth
*.pt
*.ckpt
*.pth.tar

# Large archives
*.tar.gz
*.tar
*.zip

# Experiment-generated outputs (preserve scripts)
experiments/*/outputs/
experiments/*/results/
experiments/*/logs/
tmp/
temp/

# Accidental nested repository
Social-Transmotion-Research/